{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "open-todo",
  "version": "0.0.1",
  "identifier": "com.alvistar.open-todo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev -- --host 127.0.0.1",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "open-todo",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'", "asset:"],
        "connect-src": ["'self'", "http:", "https:"],
        "img-src": ["'self'", "asset:", "data:", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'", "data:"],
        "script-src": ["'self'"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"]
      },
      "devCsp": {
        "default-src": ["'self'", "http://127.0.0.1:5173", "asset:"],
        "connect-src": ["'self'", "http:", "https:", "ws://127.0.0.1:5173"],
        "img-src": ["'self'", "asset:", "data:", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": ["'self'", "data:"],
        "script-src": ["'self'", "'unsafe-eval'"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "form-action": ["'self'"]
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
